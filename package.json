{
  "name": "lingotrace-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0 --port 4173",
    "build": "next build --webpack && node scripts/assemble-site.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test studio/core/*.test.ts studio/scene/*.test.ts && node --experimental-strip-types --test studio/media/*.test.mjs"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "motion": "14.0.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "tsx": "4.20.6",
    "@napi-rs/canvas": "0.1.100"
  },
  "type": "module"
}